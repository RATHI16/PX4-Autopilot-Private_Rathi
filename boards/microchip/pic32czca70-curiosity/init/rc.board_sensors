#!/bin/sh
#
# PIC32CZ CA70 Curiosity - sensors init
#------------------------------------------------------------------------------
# I2C bus: TWIHS0 (PX4 bus 1) — PA3=SDA (EXT1 pin 11), PA4=SCL (EXT1 pin 12)
#
# Active sensors (I2C):
#   - MIKROE-2935: GeoMagnetic Click (BMM150)  - I2C bus 1, addr 0x10
#   - MIKROE-3566: Pressure 5 Click (BMP388)   - I2C bus 1, addr 0x76 (SDO=GND)
#                                                             or 0x77 (SDO=VDD)
#   - Holybro GPS (IST8310 mag)                - I2C bus 1, addr 0x0E (TODO)
#
# ICM-45686 NOTE: the icm45686 PX4 driver is SPI-only (no I2C support).
#   Connect via SPI0: MOSI=PD21, MISO=PD20, SCK=PD22, CS=PD25, DRDY=PD28.
#   Once wired for SPI, uncomment the icm45686 line below and remove it
#   from the I2C-only section.
#------------------------------------------------------------------------------

# ADC - Battery voltage/current monitoring
board_adc start

# ICM-45686 IMU (accel + gyro) - SPI-only driver; enable when SPI wired
icm45686 -s -b 1 start

# BMM150 Magnetometer - I2C bus 1 (TWIHS0), default addr 0x10 (CSB=GND, SDO=GND)
bmm150 -X -b 1 start

# BMP388 Barometer - I2C bus 1 (TWIHS0)
# Try 0x76 (SDO=GND, default). If probe fails, try 0x77 (SDO=VDD):
bmp388 -X -b 1 -f 100 start

# IST8310 Magnetometer (Holybro GPS internal) - I2C bus 1, addr 0x0E
# Uncomment when GPS is connected
#ist8310 -X -b 1 -a 0x0E start
