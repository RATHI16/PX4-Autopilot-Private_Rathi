#!/bin/sh
#
# Custom FC Board - sensors init
#------------------------------------------------------------------------------
# Active sensors:
#   - ICM-45686 IMU2 - SPI1 (PC26/PC27/PC24, CS=PC25) via J11
#   - BMM150 Magnetometer - I2C bus 1 (TWIHS0: PA3/PA4), addr 0x10
#   - BMP388 Barometer - I2C bus 1 (TWIHS0: PA3/PA4), addr 0x77
#------------------------------------------------------------------------------

# Wait for SPI bus to be ready
sleep 1

# ICM-45686 IMU2 (accel + gyro) - SPI bus 2 (SPI1)
if ! icm45686 -s -b 2 start
then
    # Retry after additional delay
    sleep 1
    icm45686 -s -b 2 start
fi

# BMM150 Magnetometer - I2C bus 1 (TWIHS0), address 0x10
bmm150 -X -b 1 start

# BMP388 Barometer - I2C bus 1 (TWIHS0), address 0x77 (SDO=VCC)
bmp388 -X -b 1 -a 119 start
