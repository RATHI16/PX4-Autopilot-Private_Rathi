# ── GPS module safety button + LED (PE4 switch / PE3 LED) ──
safety_button start

# ── Power Monitor: auto-detect PAC1711 or INA228/PM02D ──
# BAT1_SOURCE=1 (External) stops the analog ADC battery_status so the I2C
# monitor is the sole battery publisher regardless of which chip is present.
param set-default BAT1_SOURCE 1
if pac1711 start; then
    echo "[power] PAC1711 (EV79R88A) started on I2C2"
else
    if ina228 start -X -b 3 -a 0x45 -k -t 1; then
        echo "[power] INA228/PM02D started on I2C2 @0x45"
    else
        echo "[power] no I2C power monitor found on bus 3"
    fi
fi

# ── IMU Heater: closed-loop thermostat on PE5 ──
# Holds ICM45686 die at SENS_IMU_TEMP (55C). SENS_TEMP_ID = accel device_id.
param set-default SENS_TEMP_ID 3407890
param set-default SENS_IMU_TEMP 55
heater start

# ── Dataman ───────────────────────────────────
dataman start -f /fs/mtd_waypoints
