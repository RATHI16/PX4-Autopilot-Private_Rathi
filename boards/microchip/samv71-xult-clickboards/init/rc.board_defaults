#!/bin/sh
# board defaults
# MAVLink enabled on USB CDC/ACM (ttyACM0)
# Default airframe: Generic Quad (4001), can be changed to HIL (1001) via param save
param set-default SYS_AUTOSTART 4001
param set-default SYS_USB_AUTO 0
param set-default USB_MAV_MODE 0
param set-default MAV_0_CONFIG 101
param set-default MAV_0_RATE 57600
param set-default MAV_0_FORWARD 0
param set-default SDLOG_MODE 0
param set-default SDLOG_PROFILE 1

# Disable external I2C sensor probing (we use specific Click board drivers)
param set-default SENS_EXT_I2C_PRB 0

# Sensor processing pipelines (required for both real sensors and HITL)
param set-default SYS_HAS_MAG 1
param set-default SYS_HAS_BARO 1

# HITL vs Flight mode circuit breakers
if param compare SYS_AUTOSTART 1001
then
	# HITL mode: bypass checks that can't pass in simulation
	param set-default CBRK_SUPPLY_CHK 894281
	param set-default CBRK_FLIGHTTERM 121212
	param set-default HIL_ACT_FUNC1 101
	param set-default HIL_ACT_FUNC2 102
	param set-default HIL_ACT_FUNC3 103
	param set-default HIL_ACT_FUNC4 104
else
	# Flight mode: clear any persisted HITL breaker values.
	# param reset removes from user_config so firmware default (0) applies.
	param reset CBRK_SUPPLY_CHK
	param reset CBRK_FLIGHTTERM
fi

# Allow arming without GPS on dev board (safe for both modes)
param set-default COM_ARM_WO_GPS 1

# GPS Configuration
# GPS on UART2 = /dev/ttyS1 (PD25/PD26) — UART0 disabled, ttyS renumbered
param set-default GPS_1_CONFIG 201
param set-default SER_GPS1_BAUD 57600

# RC Input Configuration
# RC on UART4 = /dev/ttyS2 (PD19) — UART0 disabled, ttyS renumbered
param set-default RC_PORT_CONFIG 300

# PWM output defaults (quadcopter motor mapping)
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default PWM_MAIN_MIN1 1100
param set-default PWM_MAIN_MIN2 1100
param set-default PWM_MAIN_MIN3 1100
param set-default PWM_MAIN_MIN4 1100
param set-default PWM_MAIN_MAX1 1900
param set-default PWM_MAIN_MAX2 1900
param set-default PWM_MAIN_MAX3 1900
param set-default PWM_MAIN_MAX4 1900
param set-default PWM_MAIN_DIS1 1000
param set-default PWM_MAIN_DIS2 1000
param set-default PWM_MAIN_DIS3 1000
param set-default PWM_MAIN_DIS4 1000
param set-default PWM_MAIN_FAIL1 1000
param set-default PWM_MAIN_FAIL2 1000
param set-default PWM_MAIN_FAIL3 1000
param set-default PWM_MAIN_FAIL4 1000
param set-default PWM_MAIN_TIM0 400

# Arming convenience for dev board
param set-default COM_ARM_SDCARD 0
param set-default COM_ARM_CHK_ESCS 0
param set-default MAV_PROTO_VER 2

# Dataman on QSPI flash (persistent mission/geofence/rally storage).
# Must run before common rcS dataman section — second start is a no-op.
if [ -e /fs/mtd_waypoints ]; then
	dataman start -f /fs/mtd_waypoints
else
	echo "WARN [init] QSPI waypoints partition not found, dataman will use SD fallback"
fi
