#
# Microchip SAMD21J18A PX4IO co-processor NuttX defconfig
# SAMD21J18A: 256KB flash, 32KB RAM, Cortex-M0+, 48 MHz
#
CONFIG_ARCH="arm"
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../../../../boards/microchip/samd21-io/nuttx-config"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="microchip"
CONFIG_ARCH_CHIP="samd2l2"
CONFIG_ARCH_CHIP_SAMD2L2=y
CONFIG_ARCH_CHIP_SAMD21J18A=y
CONFIG_ARCH_CHIP_SAMD2X=y
CONFIG_ARCH_FAMILY_SAMD21=y

# System
CONFIG_BOARD_LOOPSPERMSEC=3000
CONFIG_DEBUG_FULLOPT=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_DEFAULT_SMALL=y
CONFIG_DISABLE_MOUNTPOINT=y
CONFIG_FDCLONE_DISABLE=y
CONFIG_FDCLONE_STDIO=y
CONFIG_HAVE_CXX=y
CONFIG_HAVE_CXXINITIALIZE=y

# Memory
CONFIG_RAM_SIZE=32768
CONFIG_RAM_START=0x20000000
CONFIG_MM_SMALL=y
CONFIG_MM_FILL_ALLOCATIONS=y

# Task/stack sizing (tight - PX4IO is constrained)
CONFIG_IDLETHREAD_STACKSIZE=512
CONFIG_INIT_ENTRYPOINT="user_start"
CONFIG_INIT_STACKSIZE=1536
CONFIG_PREALLOC_TIMERS=0
CONFIG_TASK_NAME_SIZE=0
CONFIG_NAME_MAX=12

# Output
CONFIG_RAW_BINARY=y
CONFIG_STDIO_DISABLE_BUFFERING=y
CONFIG_SERIAL_TERMIOS=y

# SAMD21 peripherals
# SERCOM5 = FMU UART link (1.5 Mbps)
CONFIG_SAMD2L2_SERCOM5=y
CONFIG_USART5_RXBUFSIZE=128
CONFIG_USART5_TXBUFSIZE=128
CONFIG_USART5_SERIAL_CONSOLE=y

# SERCOM3 = SBUS input (100 kbps inverted)
CONFIG_SAMD2L2_SERCOM3=y
CONFIG_USART3_RXBUFSIZE=64
CONFIG_USART3_TXBUFSIZE=64

# SERCOM0 = DSM/Spektrum input
CONFIG_SAMD2L2_SERCOM0=y
CONFIG_USART0_RXBUFSIZE=64
CONFIG_USART0_TXBUFSIZE=32

# DMAC (needed for FMU serial link) — depends on EXPERIMENTAL
CONFIG_EXPERIMENTAL=y
CONFIG_SAMD2L2_DMAC=y

# ADC (VSERVO + RSSI)
CONFIG_SAMD2L2_ADC0=y

# WDT
CONFIG_SAMD2L2_WDT=y

# Misc
CONFIG_USEC_PER_TICK=1000
CONFIG_STACK_COLORATION=y
CONFIG_START_DAY=1
CONFIG_START_MONTH=1
